{
  "manifest_version": 3,
  "name": "DevTools Extension",
  "version": "1.0.0",
  "devtools_page": "devtools.html",
  "icons": {
    "48": "png/ai.png"
  },
  "permissions": ["tabs", "cookies", "storage", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "bridge.js",
        "message-types.js",
        "logger.js",
        "monaco-workers/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.tailwindcss.com; child-src 'self';"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}
